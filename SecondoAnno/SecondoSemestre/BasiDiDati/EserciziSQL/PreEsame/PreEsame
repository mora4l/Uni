/*Elencare tutti gli utenti che non hanno mai effettuato un prestito.*/
select utenti.*
from utenti left join prestiti on utenti.id_utente = prestiti.id_utente
where prestiti.id_prestito is null ;

/*Trovare i libri che non sono mai stati presi in prestito.*/
select libri.*
from prestiti right join libri on prestiti.id_libro = libri.id_libro 
where prestiti.id_prestito is null ;

/*Per ogni città, mostrare il numero di utenti iscritti.*/
select citta,count(*)
from utenti
group by citta;

/*Trovare il libro più prestato in assoluto (con il maggior numero di prestiti totali).*/
select * 
from (
        select libri.id_libro as "id" , count(*) as "volte_prestiti"
        from prestiti join libri on prestiti.id_libro = libri.id_libro
        group by libri.id_libro
) as "secondatab"
where secondatab.volte_prestiti =   (
                                    select max(lib.libriprestati)
                                    from (
                                            select count(*) as "libriprestati"
                                            from prestiti join libri on prestiti.id_libro = libri.id_libro
                                            group by libri.id_libro 
                                         ) as "lib"
                                    ); 
                                    
