-- ============================================================
--  BIBLIOTECA  –  DDL + DML per SQLiteStudio
-- ============================================================
 
PRAGMA foreign_keys = ON;
 
-- ------------------------------------------------------------
--  DROP (ordine inverso per rispettare le FK)
-- ------------------------------------------------------------
DROP TABLE IF EXISTS prestiti;
DROP TABLE IF EXISTS libri;
DROP TABLE IF EXISTS utenti;
DROP TABLE IF EXISTS autori;
 
-- ------------------------------------------------------------
--  CREATE
-- ------------------------------------------------------------
 
CREATE TABLE autori (
    id_autore   INTEGER PRIMARY KEY AUTOINCREMENT,
    nome        TEXT    NOT NULL,
    cognome     TEXT    NOT NULL,
    nazionalita TEXT
);
 
CREATE TABLE libri (
    id_libro  INTEGER PRIMARY KEY AUTOINCREMENT,
    titolo    TEXT    NOT NULL,
    id_autore INTEGER NOT NULL,
    genere    TEXT,
    anno      INTEGER,
    editore   TEXT,
    FOREIGN KEY (id_autore) REFERENCES autori(id_autore)
);
 
CREATE TABLE utenti (
    id_utente       INTEGER PRIMARY KEY AUTOINCREMENT,
    nome            TEXT NOT NULL,
    cognome         TEXT NOT NULL,
    email           TEXT UNIQUE,
    citta           TEXT,
    data_iscrizione TEXT   -- SQLite non ha tipo DATE nativo; si usa TEXT ISO 8601
);
 
CREATE TABLE prestiti (
    id_prestito INTEGER PRIMARY KEY AUTOINCREMENT,
    id_utente   INTEGER NOT NULL,
    id_libro    INTEGER NOT NULL,
    data_inizio TEXT    NOT NULL,
    data_fine   TEXT,
    restituito  INTEGER DEFAULT 0,   -- 0 = FALSE, 1 = TRUE
    FOREIGN KEY (id_utente) REFERENCES utenti(id_utente),
    FOREIGN KEY (id_libro)  REFERENCES libri(id_libro)
);
 
