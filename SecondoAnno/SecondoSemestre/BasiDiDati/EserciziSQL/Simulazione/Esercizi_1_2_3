/*Dato il seguente schema logico:
DIPENDENTE(cf : testo e chiave primaria, nome : testo non nullo, cognome testo non nullo, id_dipartimento : chiave
esterna su DIPARTIMENTO non nullo, stipendio : numero reale non nullo)
DIPARTIMENTO(id_dipartimento intero e chiave primaria, nome : testo non nullo, indirizzo testo opzionale)
PROGETTO(id_progetto intero e chiave primaria, nome : testo non nullo, data_inizio : data non nulla, data_fine: data
opzionale)
LAVORA(cf_dipendente : chiave esterna su dipendente, id_progetto : chiave esterna su progetto, ore_svolte : intero
non nullo)
1. Ad ogni nome di dipartimento, associare il numero di progetti (svolti da dipendenti di quel dipartimento) non
ancora terminati;
2. Ad ogni nome di progetto, associare il numero di dipendenti che vi lavorano e la somma complessiva degli
stipendi delle persone coinvolte.*/

select dipartimento.nome, count(distinct progetto.id_progetto) as "numero di progetti" /*CORREZIONE : in count devo contare gli id dei progetti in maniera distinta , non in maniera macroscopica e completamente inclusiva*/
from lavora join progetto on lavora.id_progetto = progetto.id_progetto /*prima unisco progetto a lavora , cosi da questo posso unire poi dipendente e attaccarmi poi dipartimento*/
join dipendente on lavora.cf_dipendente = dipendente.cf /*adesso attacco il tutto a dipartimento , perche mi serve il nome*/
join dipartimento on dipendente.id_dipartimento = dipartimento.id_dipartimento
/*adesso ho i dipendenti che lavorano sui progetti . poi ho le informazioni dei dipendenti e infine so in che dipartimenti lavorano quei dipendenti (e su quali progetti)*/
where progetto.data_fine IS NULL
group by dipartimento.id_dipartimento;
/*OSSERVAZIONE : avrei potuto usare LEFT JOIN nella prima join : "lavora left join progetto"*/

select count(*) as "dipendenti associati" , sum(dipendente.stipendio)
from progetto join lavora on progetto.id_progetto = lavora.id_progetto 
join dipendente on lavora.cf_dipendente = dipendente.cf
group by progetto.id_progetto,progetto.nome; /*per non ambiguita utilizzo i due identificatori del progetto che abbiamo , entrambi*/
/*OSSERVAZIONE : qui la LEFT JOIN sulla prima join è valida, ma non necessaria poichè non specificatamente richiesta*/