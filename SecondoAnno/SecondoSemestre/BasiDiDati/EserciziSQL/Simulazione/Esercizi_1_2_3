/*Dato il seguente schema logico con i seguenti dati, si scrivano le query SQLite per crearlo e popolarlo.
LIBRO(isbn : TESTO chiave primaria, titolo : TESTO NON NULLO, cf_autore chiave esterna su AUTORE NON
NULLA, numero_copie : intero maggiore di zero)
AUTORE(cf_autore TESTO chiave primaria, nome TESTO NON NULLO, cognome TESTO NON NULLO)
In AUTORE, inserire i dati relativi a J.R. Tolkien, con codice fiscale “JRTKN”, Emily Bronte con codice fiscale
“MLYBNT”. In LIBRO inserire i dati relativi a “Il Signore degli Anelli” con ISBN 00012 e “Silmarillion” con ISBN
0345 scritti da Tolkien, “Cime Tempestose” con ISBN 01234 scritto da Bronte. Di tutti i libri, sono presenti un numero
di copie a piacere (in rispetto del vincolo specificato).*/

create table if not exists Autore(
cf_autore TEXT not null primary key, 
nome TEXT not null , 
cognome TEXT not null
);
/*CORREZIONE : ricordati sempre di mettere "not null" perchè in sqlite non è dato := */

create table if not exists Libro (
isbn text primary key , 
titolo text not null , 
cf_autore not null ,
numero_copie int check(/*CORREZIONE : questo attributo mi sono sciolto di scriverlo*/
    numero_copie > 0
),
foreign key (cf_autore) references Autore(cf_autore)
);

