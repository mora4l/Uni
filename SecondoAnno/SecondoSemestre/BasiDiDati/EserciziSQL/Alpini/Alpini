/*
Crea la tabella RIVISTA con tutti i vincoli appropriati.
*/

CREATE TABLE IF NOT EXISTS Rivista(
CodR INT NOT NULL PRIMARY KEY , 
NomeR TEXT NOT NULL ,
Editore TEXT NOT NULL
)STRICT ; 

/*
Crea la tabella ARTICOLO con tutti i vincoli appropriati, 
sapendo che Argomento può assumere solo i valori 'sport', 'tempo libero', 'politica' e 'tech', 
e che esiste una dipendenza con RIVISTA.
*/
CREATE TABLE IF NOT EXISTS Articolo(
CodA INT NOT NULL PRIMARY KEY ,
Titolo int not null ,
Argomento text not null CHECK (
    Argomento = "sport" OR
    Argomento = "tempo libero" OR
    Argomento = "politica" OR
    Argomento = "tech" 
) ,  
CodR int not null ,
FOREIGN KEY ( CodR) REFERENCES Rivista (CodR) 
)STRICT;

CREATE TABLE IF NOT EXISTS Programmi(
CodiceProgramma INT NOT NULL PRIMARY KEY,
NomeProgramma TEXT NOT NULL, 
Rete TEXT NOT NULL, 
Tipologia TEXT NOT NULL
)STRICT ;

/*
Crea la tabella SONDAGGI 
sapendo che se un programma viene cancellato
, i suoi sondaggi devono essere cancellati di conseguenza.
*/
CREATE TABLE IF NOT EXISTS Sondaggi(
CodProg INT NOT NULL PRIMARY KEY,
Auditel TEXT NOT NULL , 
FOREIGN KEY (CodProg) REFERENCES Programmi (CodiceProgramma) ON DELETE CASCADE 
)STRICT;

