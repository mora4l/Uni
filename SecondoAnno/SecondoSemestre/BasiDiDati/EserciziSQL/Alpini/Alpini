/*
Crea la tabella Progetto sapendo che il budget 
non può mai essere negativo o nullo.
*/

CREATE TABLE IF NOT EXISTS Progetto(
CodP INT NOT NULL PRIMARY KEY, 
NomeP TEXT NOT NULL, 
Budget INT CHECK(
    Budget > 0 
)
)STRICT;

CREATE TABLE IF NOT EXISTS Dipartimento(
CodD INT NOT NULL PRIMARY KEY ,
NomeD TEXT NOT NULL , 
Indirizzo TEXT NOT NULL , 
Citta TEXT NOT NULL
)STRICT; 

CREATE TABLE IF NOT EXISTS Impiegato (
    CodFisc TEXT NOT NULL PRIMARY KEY, 
    Nome TEXT NOT NULL, 
    Cognome TEXT NOT NULL, 
    Recapito TEXT NOT NULL, -- Cambiato in TEXT per non perdere gli zeri iniziali
    Dip INTEGER NOT NULL,    -- Usato INTEGER per massima compatibilità STRICT
    FOREIGN KEY (Dip) REFERENCES Dipartimento (CodD) 
) STRICT;

CREATE TABLE IF NOT EXISTS Lavora_su(
Imp TEXT , 
 Prog INT , 
 PRIMARY KEY ( Imp, Prog) , 
 FOREIGN KEY (Imp) REFERENCES Impiegato (CodFisc) , 
 FOREIGN KEY (Prog) REFERENCES Progetto (CodP) ON DELETE SET NULL
)strict;
