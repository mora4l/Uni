/*
RIVISTA(CodR, NomeR, Editore)
ARTICOLO(CodA, Titolo, Argomento, CodR)
PROGRAMMI(Codice, NomeProgramma, Rete, Tipologia)
ARTISTI(Cprogramma, NomeArt)
SONDAGGI(CodProg, Auditel)
Impiegato(CodFisc, Nome, Cognome, Recapito, Dip)
Lavora_Su(Imp, Prog)
Progetto(CodP, NomeP, Budget)
Dipartimento(CodD, NomeD, Indirizzo, Citta)
*/

--Crea la tabella RIVISTA con tutti i vincoli appropriati.

CREATE TABLE IF NOT EXISTS Rivista(
CodR INT NOT NULL PRIMARY KEY , 
NomeR TEXT NOT NULL , 
Editore TEXT NOT NULL
) STRICT; 

--Crea la tabella ARTICOLO con tutti i vincoli appropriati, sapendo che Argomento può assumere solo i valori 'sport', 'tempo libero', 'politica' e 'tech', e che esiste una dipendenza con RIVISTA.
CREATE TABLE IF NOT EXISTS Articolo(
CodA INT NOT NULL PRIMARY KEY , 
Titolo TEXT NOT NULL , 
Argomento TEXT NOT NULL CHECK (
    Argomento = 'sport'  
    OR Argomento = 'tempo libero' 
    OR Argomento = 'politica' 
    OR Argomento = 'tech'
),
CodR INT NOT NULL , 
FOREIGN KEY (CodR) REFERENCES Rivista (CodR) 

)STRICT; 

CREATE TABLE IF NOT EXISTS Programmi(
Codice INT NOT NULL PRIMARY KEY , 
NomeProgramma TEXT NOT NULL , 
Rete TEXT NOT NULL , 
Tipologia TEXT NOT NULL 
)STRICT ; 

--Crea la tabella SONDAGGI sapendo che se un programma viene cancellato, i suoi sondaggi devono essere cancellati di conseguenza.
CREATE TABLE IF NOT EXISTS Sondaggi(
CodProg INT NOT NULL PRIMARY KEY , 
Auditel INT NOT NULL,
Codice INT NOT NULL ,
FOREIGN KEY (Codice) REFERENCES Programmi (Codice) ON DELETE CASCADE
)STRICT;

CREATE TABLE IF NOT EXISTS Artisti(
Cprogramma INT NOT NULL PRIMARY KEY , 
NomeArt TEXT NOT NULL , 
FOREIGN KEY (Cprogramma) REFERENCES Programmi (Codice) 
);

--Crea la tabella Progetto sapendo che il budget non può mai essere negativo o nullo.
CREATE TABLE IF NOT EXISTS Progetto(
CodP TEXT NOT NULL PRIMARY KEY , 
NomeP TEXT NOT NULL , 
Budget INT NOT NULL CHECK( 
    Budget > 0 
)
)STRICT; 

CREATE TABLE IF NOT EXISTS Dipartimento(
CodD TEXT NOT NULL PRIMARY KEY ,
NomeD TEXT NOT NULL , 
Indirizzo TEXT NOT NULL , 
Citta TEXT NOT NULL
)STRICT; 

CREATE TABLE IF NOT EXISTS Impiegato(
CodFisc TEXT NOT NULL PRIMARY KEY , 
Nome TEXT NOT NULL , 
Cognome TEXT NOT NULL , 
Recapito INT NOT NULL , 
Dip TEXT NOT NULL, 
FOREIGN KEY (Dip) REFERENCES Dipartimento (CodD) 
)STRICT; 

/*Crea la tabella Lavora_Su sapendo che se un progetto viene cancellato, il riferimento al progetto negli impiegati che ci lavoravano non deve causare errori ma 
deve semplicemente sparire.
*/
CREATE TABLE IF NOT EXISTS Lavora_su(
CodFisc TEXT NOT NULL , 
CodP TEXT NOT NULL , 
PRIMARY KEY (CodFisc,CodP) , 
FOREIGN KEY (CodFisc) REFERENCES Impiegato (CodFisc) , 
FOREIGN KEY (CodP) REFERENCES Progetto (CodP) ON DELETE CASCADE
)STRICT ; 
