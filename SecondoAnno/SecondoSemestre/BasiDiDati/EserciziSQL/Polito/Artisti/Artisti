/*Restituire l’indice Auditel del programma con codice P17*/
select Auditel
from sondaggi
where CodProg = "P17";

/*Restituire l’indice Auditel dei programmi di Fiorello*/
select sondaggi.Auditel
from artisti join programmi on artisti.CProgramma = programmi.Codice
join sondaggi on programmi.Codice = sondaggi.CodProg
where artisti.NomeArt = "Fiorello";

/*Restuire i nomi dei programmi con almeno due artisti*/
select * 
from programmi join artisti on programmi.Codice = artisti.CProgramma
group by programmi.Codice
having  count(distinct NomeArt) >= 2;

/*Restituire i nomi dei programmi con un solo artista*/
select * 
from programmi join artisti on programmi.Codice = artisti.CProgramma
group by programmi.Codice
having count(*) = 1 ; 