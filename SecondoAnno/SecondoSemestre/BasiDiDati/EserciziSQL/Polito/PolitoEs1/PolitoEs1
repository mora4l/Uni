-- ============================================================
-- CREATE TABLE
-- ============================================================

CREATE TABLE DOCENTE (
    MatrD   VARCHAR(10)  PRIMARY KEY,
    NomeD   VARCHAR(50)  NOT NULL
);

CREATE TABLE STUDENTE (
    MatrS   VARCHAR(10)  PRIMARY KEY,
    NomeS   VARCHAR(50)  NOT NULL,
    Citta   VARCHAR(50)
);

CREATE TABLE CORSO (
    CodC    VARCHAR(10)  PRIMARY KEY,
    NomeC   VARCHAR(100) NOT NULL,
    MatrD   VARCHAR(10)  NOT NULL,
    FOREIGN KEY (MatrD) REFERENCES DOCENTE(MatrD)
);

CREATE TABLE ESAME (
    CodC    VARCHAR(10)  NOT NULL,
    MatrS   VARCHAR(10)  NOT NULL,
    Data    DATE         NOT NULL,
    Voto    INT          CHECK (Voto BETWEEN 18 AND 30),
    PRIMARY KEY (CodC, MatrS),
    FOREIGN KEY (CodC)  REFERENCES CORSO(CodC),
    FOREIGN KEY (MatrS) REFERENCES STUDENTE(MatrS)
);


