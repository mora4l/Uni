/*Per ogni studente, visualizzare la matricola e il voto massimo, minimo e medio
conseguito negli esami*/
select studente.MatrS as "matricola" , min(esame.Voto) as "voto minimo" , max(esame.Voto) as "voto massimo " , avg(esame.voto) as "media dei voti" 
from studente natural join esame
group by studente.MatrS;

/*Per ogni studente, visualizzare la matricola, il nome e il voto massimo, minimo e
medio conseguito negli esami*/
select studente.MatrS as "matricola" , studente.NomeS as "nome" , min(esame.Voto) as "voto minimo" , max(esame.Voto) as "voto massimo " , avg(esame.voto) as "media dei voti" 
from studente natural join esame
group by studente.MatrS;

/*Per ogni studente che ha una media voti superiore al 28, visualizzare la matricola, il
nome e il voto massimo, minimo e medio conseguito negli esami*/
select studente.MatrS as "matricola" , studente.NomeS as "nome" , min(esame.Voto) as "voto minimo" , max(esame.Voto) as "voto massimo " , avg(esame.voto) as "media" 
from studente natural join esame
group by studente.MatrS
having avg(esame.Voto) > 28;

/*Per ogni studente che ha una media voti superiore al 28 e ha sostenuto esami in
almeno 10 date diverse, visualizzare la matricola, il nome e il voto massimo, minimo
e medio conseguito negli esami
*/
select studente.MatrS as "matricola" , studente.NomeS as "nome" , min(esame.Voto) as "voto minimo" , max(esame.Voto) as "voto massimo " , avg(esame.voto) as "media" 
from studente natural join esame
group by studente.MatrS
having count(distinct esame.Data) > 10 and avg(esame.Voto) > 28; 

