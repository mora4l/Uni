CREATE TABLE if not exists CAMPEGGIO (
    CodCampeggio     VARCHAR(10) PRIMARY KEY,
    NomeC            VARCHAR(100) NOT NULL,
    Indirizzo        VARCHAR(150),
    Comune           VARCHAR(80),
    Provincia        VARCHAR(50)
);

CREATE TABLE if not exists PIAZZOLA (
    NumeroPiazzola   INT,
    CodCampeggio     VARCHAR(10) REFERENCES CAMPEGGIO(CodCampeggio),
    Superficie       NUMERIC(6,2),
    Tipologia        VARCHAR(50),
    CostoGiornaliero NUMERIC(6,2),
    PRIMARY KEY (NumeroPiazzola, CodCampeggio)
);

CREATE TABLE if not exists PRENOTAZIONE (
    NumeroPiazzola  INT,
    CodCampeggio    VARCHAR(10),
    DataInizio      DATE,
    DataFine        DATE,
    NomeCliente     VARCHAR(100),
    PRIMARY KEY (NumeroPiazzola, CodCampeggio, DataInizio),
    FOREIGN KEY (NumeroPiazzola, CodCampeggio)
        REFERENCES PIAZZOLA(NumeroPiazzola, CodCampeggio)
);

