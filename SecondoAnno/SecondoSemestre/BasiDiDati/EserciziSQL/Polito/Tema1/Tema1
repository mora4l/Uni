/*Per i campeggi della provincia di Napoli che hanno ricevuto più di 1000 prenotazioni diverse
per le piazzole di tipologia "fronte-mare",

 visualizzare codice del campeggio, indirizzo,
comune, durata media delle prenotazioni e importo totale

 delle prenotazioni (calcolato come
il prodotto della durata della prenotazione per il costo giornaliero*/
select prenocamp.CodCampeggio as "codice del campeggio " , prenocamp.Indirizzo as "Indirizzo" , prenocamp.comune as "comune", avg(julianday(DataFine)-julianday(DataInizio)) as "permanenza media" , sum((julianday(DataFine)-julianday(DataInizio))) * piazzola.CostoGiornaliero as "importo totale" 
from (select * 
      from campeggio join prenotazione on campeggio.CodCampeggio = prenotazione.CodCampeggio
      where campeggio.Provincia = "Napoli" 
      ) as "prenocamp" join piazzola on prenocamp.NumeroPiazzola = piazzola.NumeroPiazzola and prenocamp.CodCampeggio = piazzola.CodCampeggio /*prendo tutte le prenotazioni dei campeggi di napoli e poi dopo ottengo le piazzole relative ai campeggi in provicia di napoli*/
/*adesso mi serve filtrare le prenotazioni con piazzola "fronte mare" e poi raggruppare tutte le prenotazioni fronte mare per ogni campeggio , cosi capisco ogni campeggio quante prenotazioni ha fronte mare*/
where piazzola.Tipologia = "fronte-mare"
group by prenocamp.CodCampeggio
having count(*) > 5;

