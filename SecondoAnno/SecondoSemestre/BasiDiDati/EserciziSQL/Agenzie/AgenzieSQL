create table if not exists Agenzia(
cod int not null primary key ,
nome text
); 

create table if not exists Autore(
cf text not null primary key,
nome text , 
cognome text , 
stipendio int ,
cod_ag int,
foreign key (cod_ag) references Agenzia(cod)
);

create table if not exists Articolo(
cod_art int not null primary key,
nome text
);

create table if not exists Contribuisce (
cf_a text not null , 
cod_art not null, 
ore int, 
primary key(cf_a, cod_art) , 
foreign key (cf_a) references Autore (cf), 
foreign key (cod_art) references Articolo (cod_art) 
);

