/*per ogni agenzia trovare il nome e quanti autori sono assunti*/
select agenzia.nome , count ( autore.nome) 
from autore join agenzia on autore.cod_ag=agenzia.cod 
group by agenzia.nome;

/*a partire dall'esercizio precedente , tenere traccia della somma delle ore lavorate ogni agenzia */
select agenzia.nome, count(autore.nome) as "autori assunti" , sum(contribuisce.ore) as "ore totali lavorate "
from (autore join agenzia on autore.cod_ag=agenzia.cod ) join contribuisce on autore.cf=contribuisce.cf_a
group by agenzia.nome;

/*calcolare il nome di articolo col numero più alto di ore spese sopra*/
select sum(ore) as "TOTore"
from articolo natural join contribuisce
group by cod_art
order by TOTore desc
limit 1
