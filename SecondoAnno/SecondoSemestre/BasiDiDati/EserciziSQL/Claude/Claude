/*Mostrare nome e cognome degli utenti che non hanno mai restituito un libro (hanno almeno un prestito con restituito = FALSE).*/
select utenti.nome ,utenti.cognome
from utenti left join prestiti on utenti.id_utente = prestiti.id_utente
where prestiti.restituito = FALSE ; /*ne basta anche solo uno e va bene comunque*/

/*Per ogni genere, indicare il numero di libri presenti.*/
