/*Il nome e cognome degli autori che hanno scritto più di un libro.*/
select autori.nome, autori.cognome
from libri join autori on libri.id_autore = autori.id_autore 
group by autori.id_autore
having count(distinct libri.id_libro) > 1; /*con distinct mi assicuro che se un autore ha per caso scritto più versioni di un libro (che ha lo stesso nome) , verrà contato solo una volta*/

/*Gli utenti di Milano che hanno preso in prestito almeno un libro di genere 'Distopico'.*/
select utenti.*
from utenti join prestiti on utenti.id_utente = prestiti.id_utente
join libri on prestiti.id_libro = libri.id_libro
where utenti.citta = "Milano"
group by utenti.id_utente
having count(libri.genere ) >= 1 ;  /*senza distinct perche voglio proprio le ripetizioni , o almeno uno*/

/*Per ogni utente indicare il numero di prestiti ancora aperti (non restituiti).*/
select utenti.id_utente , count(*) as "libri non restituiti" 
from utenti join prestiti on utenti.id_utente = prestiti.id_utente
where prestiti.restituito = 0 
group by utenti.id_utente; 

/*Il titolo del libro che è stato preso in prestito il maggior numero di volte.*/
select libri.titolo
from libri join prestiti on libri.id_libro = prestiti.id_libro
group by libri.id_libro
having count(*) =  ( select max(massimoprestito)/*2. poi seleziono il massimo tra tutti*/ /*3. e alla fine raggruppo di nuovo tutti i libri e cerco quello che ha il numero di prestiti (count(righe)) = al massimo di prestiti*/
                     from (select count(*) as "massimoprestito" /*1. prima mi trovo l'elenco dei valori che rappresentano il numero di prestiti per ogni libro*/
                           from utenti join prestiti on utenti.id_utente = prestiti.id_utente
                           group by prestiti.id_libro
                          )
                  );

/*Nome e cognome degli autori i cui libri non sono mai stati presi in prestito.*/
select autori.nome, autori.cognome
from libri left join prestiti on libri.id_libro = prestiti.id_libro /*prima mi trovo tutti i libri che non sono mai stati presi in prestito usando una left join che mi fa capire le tuple che non hanno un match amche solo con un prestito*/
join autori on libri.id_autore = autori.id_autore /*poi unisco autori perche voglio il nome e il cognome*/
where prestiti.id_prestito is null; /*e poi grazie alla prima join trovo questa informazione , ovvero le tuple in cui non c'è stato match*/

/*Per ogni città indicare quanti utenti sono iscritti, mostrando solo le città con più di un utente.*/
select citta, count(*) as "iscritti"
from utenti 
group by citta
having count(*) > 1;

/*I titoli dei libri presi in prestito da almeno due utenti diversi.*/
select libri.titolo
from utenti join prestiti on utenti.id_utente = prestiti.id_utente
join libri on prestiti.id_libro = libri.id_libro
group by libri.id_libro
having count(distinct utenti.id_utente) >= 2; 

/*L'utente che ha effettuato più prestiti in totale (restituiti e non).*/
select utenti.*
from utenti join prestiti on utenti.id_utente = prestiti.id_utente
group by utenti.id_utente
having count(*) = ( select max(maxprestiti) /*2. poi da quell'elenco seleziono il valore più alto*/ /*3. e infine restituisco tutti gli utenti che hanno il numero di prestiti pari a quest'ultimo*/
                    from (
                            select count(*) as "maxprestiti" /*1. prima mi trovo il numero di prestiti effettuati da ogni utente*/
                            from utenti join prestiti on utenti.id_utente = prestiti.id_utente
                            group by utenti.id_utente
                         )
                   );            

/*Per ogni autore indicare il numero medio di prestiti ricevuti dai suoi libri.*/
select autori.nome, autori.cognome, autori_media_prestiti.libri_prestati_medi as "libri prestati in media"
from autori join (
                    select autore_libro_prestiti.autore, avg(numero_prestiti_libro) as "libri_prestati_medi" /*ora restituisco per ogni autore il numero di prestiti medio che è stato calcolato da tutti i valori dei prestiti che c'erano per ogni libro*/
                    from (
                            select libri.id_autore as "autore",libri.id_libro as "libro", count(*) as "numero_prestiti_libro" /*2. a questo punto ho l'autore e affianco il libro che ha scritto e il relativo numero di copie imprestate*/
                            from libri left join prestiti on libri.id_libro = prestiti.id_libro /*1. prima mi trovo per ogni libro la lista dei prestiti. metto left join cosi prendo anche i libri senza prestiti*/
                            group by libri.id_libro) as "autore_libro_prestiti"/*mi serve per forza rinominare la tabella e gli attributi nella select per capirci meglio */
                    group by autore_libro_prestiti.autore/*3. poi da questa tabella del punto 2. mi raggruppo tutte le informazioni in base all'autore*/
) as "autori_media_prestiti" on autori.id_autore = autori_media_prestiti.autore;

/*I libri presi in prestito da tutti gli utenti di Roma.*/
select libri.*
from utenti join prestiti on utenti.id_utente = prestiti.id_utente
join libri on prestiti.id_libro = libri.id_libro
where utenti.citta = "Roma"; 

/*Nome e cognome degli utenti che hanno preso in prestito libri di almeno due generi diversi.*/
select genere_prestiti_utente.nome,genere_prestiti_utente.cognome /*6. quindi ora mi prendo i nomi e i cognomi di quelli che hanno più di 2 nella casella che rappresenta la somma dei generi distinti che ha letto*/
from (
        select utenti.id_utente as "utente",utenti.nome as "nome" , utenti.cognome as "cognome",  count (distinct libri.genere) as "numero_generi_utente" /*3. nella tabella risultante mi metto il nome e cognome dell'utente e affianco anche la somma dei generi dei libri che ha letto . uso distinct perche se ha letto solo libri dello stesso genere non vale*/
        from prestiti join libri on prestiti.id_libro = libri.id_libro/*1. prima mi trovo tutti gli utenti con i relativi libri che hanno preso in prestito*/
        join utenti on prestiti.id_utente = utenti.id_utente
        group by utenti.id_utente /*2. e poi mi raggruppo tutti i prestiti in base ad ogni utente*/
     ) as "genere_prestiti_utente" /*4. la rinomino per chiarezza e la userò per trovare quali utenti hanno più di 2 generi diversi letti in totale*/
where genere_prestiti_utente.numero_generi_utente >= 2; /*5. ora devo selezionare esclusivamente gli utenti che hanno >= 2 generi letti*/

