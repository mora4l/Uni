-- =============================================
-- CREATE TABLE
-- =============================================

CREATE TABLE categorie (
    id_categoria INT PRIMARY KEY,
    nome         VARCHAR(100) NOT NULL,
    descrizione  TEXT
);

CREATE TABLE social_network (
    id_social_network INT PRIMARY KEY,
    nome              VARCHAR(100) NOT NULL
);

CREATE TABLE tutorial (
    id_tutorial  INT PRIMARY KEY,
    titolo       VARCHAR(200) NOT NULL,
    descrizione  TEXT,
    livello      VARCHAR(50),
    durata       INT NOT NULL,  -- durata in minuti
    link         VARCHAR(300),
    id_categoria INT REFERENCES categorie(id_categoria)
);

CREATE TABLE tutorial_social_network (
    id_tutorial       INT REFERENCES tutorial(id_tutorial),
    id_social_network INT REFERENCES social_network(id_social_network),
    PRIMARY KEY (id_tutorial, id_social_network)
);


