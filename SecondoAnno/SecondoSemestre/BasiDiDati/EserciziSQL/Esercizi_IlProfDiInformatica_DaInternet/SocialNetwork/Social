/*Titolo, descrizione e livello dei tutorial il cui titolo inizia con la lettera 'I'. */

select titolo,descrizione,livello
from tutorial 
where titolo like "I%";
 
/*Elenco dei tutorial che appartengono alle seguenti categorie: Programmazione, Musica e Sport.*/
select tutorial.*
from tutorial join categorie on tutorial.id_categoria = categorie.id_categoria
where categorie.nome = "Programmazione " or categorie.nome ="Musica" or categorie.nome ="Sport";

/*Elenco dei tutorial la cui durata è compresa tra 5 minuti e 15 minuti.*/
select * 
from tutorial 
where durata between 5 and 15;

/*Per ogni livello indicare quanti tutorial sono presenti nel database.*/
select livello,count(*) as "tutorial del livello"
from tutorial
group by livello;

/*Nomi dei social network in cui sono stati pubblicati almeno 5 tutorial.*/
select social_network.nome
from (tutorial join tutorial_social_network on tutorial.id_tutorial = tutorial_social_network.id_tutorial) /*prima vado a trovare gli id dei social corrispondenti ad ogni tutorial*/
     join social_network on tutorial_social_network.id_social_network = social_network.id_social_network/*poi ottengo le informazioni di ogni social legate all'id relativo che ho ottenuto prima , che è legato a sua volta dai tutorial che ha */
group by social_network.nome
having count(*) >= 5;

/*Elenco dei tutorial che hanno durata pari alla durata massima dei tutorial presenti nel database.*/
select tutorial.*
from tutorial
where durata = ( select max(durata) as "durata_massima_tutorial"/*1. prima mi trovo la durata massima dei tutorial in generale, poi seleziono tutte le tuple che hanno quella durata*/
                 from tutorial
               ); 
               
/*Indicare quanti tutorial sono stati pubblicati nel social network 'Facebook'.*/
select social_network.nome,count(*) as "tutorial pubblicati"
from (tutorial join tutorial_social_network on tutorial.id_tutorial = tutorial_social_network.id_tutorial)/*prima vado a trovare gli id dei social corrispondenti ad ogni tutorial*/
     join social_network on tutorial_social_network.id_social_network = social_network.id_social_network /*poi ottengo le informazioni di ogni social legate all'id relativo che ho ottenuto prima , che è legato a sua volta dai tutorial che ha */
where social_network.nome = "Facebook"/*poi filtro le tuple in cui c'è solo facebook*/
group by social_network.nome; /*raggruppo le tuple per ogni social, cosi posso contare nella select le tuple di ogni gruppo */

/*Elenco dei tutorial di categoria 'Programmazione' presenti nel social network 'Instagram'.*/
select tutorial.*
from ((tutorial join tutorial_social_network on tutorial.id_tutorial = tutorial_social_network.id_tutorial )/*prima vado a trovare gli id dei social corrispondenti ad ogni tutorial*/
     join social_network on tutorial_social_network.id_social_network = social_network.id_social_network)/*poi ottengo le informazioni di ogni social legate all'id relativo che ho ottenuto prima , che è legato a sua volta dai tutorial che ha */
     join categorie on tutorial.id_categoria = categorie.id_categoria/*poi aggancio anche tutte le informazioni relative alla categorie che ogni tutorial ha*/
where categorie.nome = "Programmazione" and social_network.nome = "Instagram";

/*Per ogni social network indicare quanti tutorial di categoria 'Business' sono stati pubblicati.*/
select social_network.nome as "social" ,count(*) as "tutorial di business"
from ((social_network join tutorial_social_network on social_network.id_social_network = tutorial_social_network.id_social_network)/* "per cambiare un po'" , prima lego le informazioni di ogni social agli id dei tutorial che ha associato*/
join tutorial on tutorial_social_network.id_tutorial = tutorial.id_tutorial)/*poi ottengo le informazioni di ogni tutorial che ha ogni social*/
join categorie on tutorial.id_categoria = categorie.id_categoria/*e poi lego anche le informazioni della categoria di ogni tutorial (che ha ogni social)*/
where categorie.nome = "Business" 
group by social_network.nome;

/*Elenco dei social dove non sono stati pubblicati alcun tutorial.*/
select social_network.nome as "social senza tutorial"
from social_network left join tutorial_social_network on social_network.id_social_network = tutorial_social_network.id_social_network/*lego le informazioni dei social alle corrispondenze tra gli id dei social e dei tutorial che ognuno ha. a prescindere dal match o no , prendo tutte le tuple della prima tabella*/
where id_tutorial is null;  /*se non ce stato nessun match tra le due tabelle , gli attributi della seconda tabella saranno "NULL" . è proprio quello che voglio*/

/*Elenco dei tutorial il cui titolo contiene la parola 'Java'.*/
select tutorial.*
from tutorial 
where titolo like "%Java%";

/*Il titolo dei tutorial che sono di livello di Intermedio e che hanno una durata più lunga della durata media tra tutti i tutorial di livello Intermedio.*/
select tutorial.titolo
from tutorial
where livello = "Intermedio" and durata > (/*2. poi vado a cercare tutti i tutorial di livello intermedio che hanno la durata sopra quel valore , che è proprio la media dei tutorial "Intermedi" */
                                                select avg(durata) as "durata_media" /*1. prima trovo la durata media dei tutorial di livello intermedio*/
                                                from tutorial
                                                where livello = "Intermedio" 
                                          );

/*Per ogni categoria si vuole conoscere il numero di tutorial presenti nel social network 'Instagram'.*/
select categorie.nome as "categorie di tutorial su instagram", count(*) as "tutorial presenti"
from ((categorie join tutorial on categorie.id_categoria = tutorial.id_categoria )/*scelgo di partire ottenendo le informazioni di ogni categoria legata ad ogni tutorial*/
join tutorial_social_network on tutorial.id_tutorial = tutorial_social_network.id_tutorial)/*poi associo ad ogni tutorial (con le relative informazioni sulla categoria) l' id del social che ha quel determinato tutorial*/
join social_network on tutorial_social_network.id_social_network = social_network.id_social_network /*e infine ottento le informazioni di ogni social (legato ad ogni tutorial che ha a sua volta legate tutte le informazioni sulla categoria associata) */
where social_network.nome = "Instagram"
group by categorie.nome;

/*Elenco dei tutorial ordinati da quello più breve a quello più lungo e a parità di durata ordinarli in base al titolo in ordine alfabetico.*/
select * 
from tutorial 
order by durata asc , titolo asc;

/*Per ogni tutorial presente nel database indicare: il nome del tutorial, il livello, la durata, il nome della categoria, 
ed il nome del social network in cui è pubblicato. 
Se un tutorial è stato pubblicato in più social network, nella tabella risultante si avranno più righe per quel tutorial.*/
select tutorial.titolo as "titolo tutorial", tutorial.livello as "livello tutorial", tutorial.durata as "durata tutorial", categorie.nome as "categoria" , social_network.nome as "nome social"
from ((categorie join tutorial on categorie.id_categoria = tutorial.id_categoria)/*solite join : unisco prima le categorie ai tutorial...*/
left join tutorial_social_network on tutorial.id_tutorial = tutorial_social_network.id_tutorial)/*poi unisco i tutorial agli id dei social associati. metto left cosi prenderò anche i tutorial che non sono in nessun social*/
left join social_network on tutorial_social_network.id_social_network = social_network.id_social_network;/*e infine unisco le informazioni sui social che hanno quei tutorial che a loro volta hanno la categoria associata. metto left anche qui per mantenere le tuple in cui un tutorial non è in nessun social*/

