-- ========================
--  CREATE TABLE
-- ========================

CREATE TABLE discoteche (
    id_discoteca  INTEGER       PRIMARY KEY,
    nome          TEXT          NOT NULL,
    indirizzo     TEXT,
    citta         TEXT,
    telefono      TEXT
);

CREATE TABLE dj (
    id_dj           INTEGER  PRIMARY KEY,
    nome            TEXT     NOT NULL,
    genere_musicale TEXT
);

CREATE TABLE eventi (
    id_evento    INTEGER  PRIMARY KEY,
    nome         TEXT     NOT NULL,
    data         TEXT     NOT NULL,
    orario       TEXT,
    descrizione  TEXT,
    prezzo       REAL,
    id_discoteca INTEGER  NOT NULL,
    FOREIGN KEY (id_discoteca) REFERENCES discoteche(id_discoteca)
);

CREATE TABLE dj_eventi (
    id_dj     INTEGER NOT NULL,
    id_evento INTEGER NOT NULL,
    PRIMARY KEY (id_dj, id_evento),
    FOREIGN KEY (id_dj)     REFERENCES dj(id_dj),
    FOREIGN KEY (id_evento) REFERENCES eventi(id_evento)
);

