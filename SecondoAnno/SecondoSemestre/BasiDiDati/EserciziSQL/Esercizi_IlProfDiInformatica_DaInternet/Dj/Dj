/*Le informazioni delle discoteche che hanno eventi disponibili a partire dal 1 aprile 2023.*/
select discoteche.*
from discoteche join eventi on discoteche.id_discoteca = eventi.id_discoteca
where eventi.data >= "2023-04-01" ;

/*La media dei prezzi degli eventi delle discoteche che si trovano a Roma.*/
select avg(eventi.prezzo) as "media prezzo "
from discoteche join eventi on discoteche.id_discoteca = eventi.id_discoteca
where discoteche.citta = "Roma";
                
/*Il numero di discoteche presenti a Roma.*/
select count(*) as "discoteche romane"
from discoteche
where citta = "Roma";

/*Per ogni città indicare quante discoteche sono presenti. */
select citta, count(*) as "disco presenti"
from discoteche
group by citta;

/*Elenco dei dj presenti per l'evento 'Festa House'. 
Oltre al nome del dj mostrare a schermo anche il suo genere musicale. */
select *
from dj join dj_eventi on dj.id_dj = dj_eventi.id_dj
join eventi on dj_eventi.id_evento = eventi.id_evento
where eventi.nome = "Festa House" ; 

/*Nomi dei dj che partecipano agli eventi che hanno il prezzo più caro.*/
select * 
from dj join dj_eventi on dj.id_dj = dj_eventi.id_dj
join eventi on dj_eventi.id_evento = eventi.id_evento
where prezzo = (
                select max(prezzo) as "prezzo_massimo"
                from eventi
               ) ; 
/*Elenco degli eventi delle discoteche romane a partire dal 01/01/2022 ordinati dal più recente al meno recente.*/
select eventi.nome
from discoteche join eventi on discoteche.id_discoteca = eventi.id_discoteca
where discoteche.citta = "Roma" and eventi.data >= "2022-01-01"
order by eventi.data asc;

/*Elenco degli eventi per cui non è previsto alcun dj.*/
select eventi.*
from eventi left join dj_eventi on eventi.id_evento = dj_eventi.id_evento
where id_dj is null;

/*Nomi dei dj che hanno partecipato ad eventi presso discoteche di Roma.*/
select dj.nome
from dj join dj_eventi on dj.id_dj = dj_eventi.id_dj
join eventi on dj_eventi.id_evento = eventi.id_evento 
join discoteche on eventi.id_evento = discoteche.id_discoteca
where citta = "Roma";

/*Indicare il numero di eventi a cui ha partecipato ogni dj presente nel db.*/
select dj.nome , count(*)
from dj left join dj_eventi on dj.id_dj = dj_eventi.id_dj
group by dj.id_dj
