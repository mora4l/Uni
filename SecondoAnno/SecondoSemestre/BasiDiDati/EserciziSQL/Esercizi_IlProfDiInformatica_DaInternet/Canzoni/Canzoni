-- Tabella utenti
CREATE TABLE utenti (
    id_utente   INT PRIMARY KEY,
    nome        VARCHAR(50) NOT NULL,
    cognome     VARCHAR(50) NOT NULL
);

-- Tabella playlist
CREATE TABLE playlist (
    cod_playlist INT PRIMARY KEY,
    nome         VARCHAR(100) NOT NULL,
    id_utente    INT REFERENCES utenti(id_utente)
);

-- Tabella canzoni
CREATE TABLE canzoni (
    id_canzone   INT PRIMARY KEY,
    titolo       VARCHAR(150) NOT NULL,
    durata       INT NOT NULL,  -- durata in secondi
    genere       VARCHAR(50),
    data_uscita  DATE,
    num_ascolti  INT DEFAULT 0
);

-- Tabella associativa canzoni_playlist
CREATE TABLE canzoni_playlist (
    id_canzone   INT REFERENCES canzoni(id_canzone),
    cod_playlist INT REFERENCES playlist(cod_playlist),
    PRIMARY KEY (id_canzone, cod_playlist)
);
    

