/*Il numero di ascolti maggiore, quello minore e quello medio ricevuto dalle canzoni presenti nel database*/

select max(stream) as "massimo_stream", min(stream) as "minimo_stream", avg(stream) as "media_stream"
from (    select num_ascolti as "stream"
          from canzoni 
          group by num_ascolti
     );

/*Il numero di canzoni  con genere pop e durata maggiore di 3 minuti.*/
          
select *
from canzoni
where genere = "pop" and durata > 60*3;   --la durata è espressa in secondi--


/*Titolo, durata e numero di ascolti delle canzoni uscite dal 2022 in poi. */

select titolo,durata,num_ascolti
from canzoni
where data_uscita > 2022; 

/*Elenco delle canzoni presenti nella playlist "Mattia04"*/

select canzoni.*
from (playlist join canzoni_playlist on playlist.cod_playlist = canzoni_playlist.cod_playlist ) /*mi serve per ottenere gli id di tutte le canzoni di ogni playlist*/
      join canzoni on canzoni_playlist.id_canzone = canzoni.id_canzone /*ora unisco le informazioni di ogni canzone che sta dentro ogni playlist */
where playlist.nome = "Mattia04";

/*Elenco delle canzoni presenti nella playlist dell'utente Mara Sattei.*/
 
select distinct canzoni.* /*metto distinct perchè se ci fossero le stesse canzoni in più playlist me le mostrerebbe doppie*/
from (((utenti join playlist on utenti.id_utente = playlist.id_utente )/*mi serve per capire tutte le playlist di tutti gli utenti*/
     join canzoni_playlist on playlist.cod_playlist = canzoni_playlist.cod_playlist)/*ora ottengo gli id di tutte le canzoni (relative ad ogni playlist che ha ogni utente)*/
     join canzoni on canzoni_playlist.id_canzone = canzoni.id_canzone)/*ora ottengo tutte le informazioni di tutte le canzoni (relative ad ogni playlist che ha ogni utente)*/
where utenti.nome = "Mara" and utenti.cognome = "Sattei";

/*Elenco delle canzoni ordinate sulla base della data di uscita (dalla più recente alla meno recente) 
 e a parità di data di uscita ordinarle sulla base del titolo in ordine alfabetico.*/
 select * 
 from canzoni
 order by data_uscita desc , titolo asc;
 
 /*Nome e cognome degli utenti che hanno creato playlist al cui interno è presente la canzone "Sorriso grande".*/
 
 select utenti.nome,utenti.cognome
 from ((utenti join playlist on utenti.id_utente = playlist.id_utente) /*intanto trovo tutte le playlist che ha ogni utente*/
      join canzoni_playlist on playlist.cod_playlist = canzoni_playlist.cod_playlist)/*poi trovo gli id delle canzoni che stanno in ogni playlist*/  
      join canzoni on canzoni_playlist.id_canzone = canzoni.id_canzone/*e alla fine trovo tutte le informazioni delle canzoni (presenti in ogni playlist di ogni utente)*/
 where canzoni.titolo = "Sorriso grande";
 
 /*Elenco degli utenti che non hanno creato una playlist.*/
      
select utenti.* /*seleziono tutti gli utenti*/
from utenti
except /*e da questo elenco ci levo quelli che ...*/
select utenti.*
 from  utenti join playlist on utenti.id_utente = playlist.id_utente; /*... hanno una playlist associata al loro id */
 /*cosi da "tutti gli utenti" , mi sbarazzo di quelli che hanno una playlist */

/*alternativa :*/
select utenti.*
from utenti left join playlist on utenti.id_utente = playlist.id_utente /*prendo tutte le info degli utenti e...*/
where playlist.cod_playlist IS NULL;/*seleziono le tuple in cui non c'è stata una corrispondenza tra utenti e playlist ==> l'attributo cod_playlist non ha trovato match , quindi è NULL*/

