-- ============================================================
--  DDL
-- ============================================================

CREATE TABLE compagnie (
    id_compagnia          INT          PRIMARY KEY,
    nome                  VARCHAR(100) NOT NULL,
    sitoweb               VARCHAR(255),
    peso_bagaglio_incluso INT
);

CREATE TABLE aerei (
    id_aereo       INT          PRIMARY KEY,
    nome           VARCHAR(100) NOT NULL,
    tipo           VARCHAR(50),
    num_passeggeri INT,
    id_compagnia   INT          NOT NULL,
    FOREIGN KEY (id_compagnia) REFERENCES compagnie(id_compagnia)
);

CREATE TABLE aeroporti (
    id_aeroporto  INT          PRIMARY KEY,
    nome          VARCHAR(100) NOT NULL,
    via           VARCHAR(150),
    citta         VARCHAR(100),
    nazione       VARCHAR(100),
    num_terminali INT,
    num_piste     INT
);

CREATE TABLE voli (
    id_volo               INT         PRIMARY KEY,
    codice_volo           VARCHAR(20) NOT NULL,
    data                  DATE,
    ora_partenza          TIME,
    ora_arrivo            TIME,
    id_aereo              INT         NOT NULL,
    id_aeroporto_partenza INT         NOT NULL,
    id_aeroporto_arrivo   INT         NOT NULL,
    FOREIGN KEY (id_aereo)              REFERENCES aerei(id_aereo),
    FOREIGN KEY (id_aeroporto_partenza) REFERENCES aeroporti(id_aeroporto),
    FOREIGN KEY (id_aeroporto_arrivo)   REFERENCES aeroporti(id_aeroporto)
);

