/*Le compagnie aeree per cui non è specificato il sito web.*/
select * 
from compagnie
where sitoweb IS NULL  ;

/*La nazione di partenza e la nazione di arrivo del volo con codice volo "A357Z".*/
select partenza.codice_volo ,partenza.nazione as "nazione di partenza", aeroporti.nazione as "nazione di arrivo"
from (  select voli.codice_volo,voli.id_aeroporto_arrivo, nazione
        from voli join aeroporti on voli.id_aeroporto_partenza = aeroporti.id_aeroporto
        where voli.codice_volo  = "A357Z") as "partenza" 
        join aeroporti on partenza.id_aeroporto_arrivo=aeroporti.id_aeroporto;

/*Il nome della compagnia dell'aereo usato nel volo con id_volo uguale a 5.*/
select compagnie.nome
from (voli join aerei on voli.id_aereo = aerei.id_aereo) join compagnie on aerei.id_compagnia = compagnie.id_compagnia
where voli.id_volo= 5;

/*Gli aereoporti da cui partono voli internazionali. 
(Sugg: un volo è considerato internazionale se parte l'aeroporto di arrivo si trova in una nazione diversa dall'aeroporto di partenza).*/
select distinct (coca.aeroporti_di_partenza) as "aeroporti con voli internazionali"
from aeroporti join  (select aeroporti.nome as "aeroporti_di_partenza" ,aeroporti.nazione as "nazione_di_partenza" , voli.id_aeroporto_arrivo as "aeroporto_arrivo" 
from voli join aeroporti on voli.id_aeroporto_partenza = aeroporti.id_aeroporto) as "coca" on aeroporti.id_aeroporto = coca.aeroporto_arrivo
where aeroporti.nazione <> coca.nazione_di_partenza;

/*Gli aeroporti italiani da cui sono partiti più di 2 voli.*/
select aeroporti.nome
from aeroporti join voli on aeroporti.id_aeroporto = voli.id_aeroporto_partenza
where aeroporti.nazione = "Italia" 
group by aeroporti.nome
having count(voli.id_volo) > 2;

/*per ogni compagni indicare il numero di aerei che ha.*/
select compagnie.nome,count(*) as "aerei posseduti" 
from compagnie join aerei on compagnie.id_compagnia = aerei.id_compagnia
group by compagnie.nome;

/*Per ogni città indicare il numero di aeroporti presenti.*/
select citta,count(id_aeroporto) as "aeroporti presenti"
from aeroporti
group by citta;

/*Il nome degli aeroporti che hanno il maggior numero di piste.*/
select *
from aeroporti 
where num_piste= (select max(num_piste)
                  from aeroporti
                 );
       
/*La media del peso del bagaglio incluso nel prezzo dalle compagnie aeree.*/
select avg(peso_bagaglio_incluso) as "peso medio del bagaglio incluso" 
from compagnie;

/*Nomi delle nazioni con più aeroporti.*/
select lista.nazione
from (select count(*) as "max", nazione
       from aeroporti
       group by nazione) as "lista"
where max
       = 
       (select max(ciao)
        from (select count(*) as "ciao"
              from aeroporti
              group by nazione) as "massimo"
);

