{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug interprete",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/lispInterpreter",
            "args": ["${workspaceFolder}/file.txt"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}